# Copy this to .env and fill in real values. .env is gitignored — never
# commit real credentials.

# -- Blackboard (Phase 2/2.1) ----------------------------------------------
BLACKBOARD_BASE_URL="https://your-institution.blackboard.com"
BLACKBOARD_TIMEZONE="America/Monterrey"

# -- Telegram bot (Phase 3) ------------------------------------------------
# Create a bot via @BotFather in Telegram, then message it once and read
# your chat_id from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# -- Claude (Phase 3 free-form chat) ---------------------------------------
# From console.anthropic.com -> API Keys. Set a usage limit there too.
ANTHROPIC_API_KEY=""
