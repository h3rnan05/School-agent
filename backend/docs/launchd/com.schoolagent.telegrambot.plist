<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.schoolagent.telegrambot</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__BACKEND_DIR__/scripts/run_bot.sh</string>
    </array>
    <!-- Long-lived process (long-polls Telegram). KeepAlive restarts it
         automatically if it ever crashes or is killed. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__BACKEND_DIR__/logs/bot.log</string>
    <key>StandardErrorPath</key>
    <string>__BACKEND_DIR__/logs/bot.error.log</string>
</dict>
</plist>
